{
  "name": "peepaway",
  "version": "1.0.0",
  "description": "Peepaway - Open Source Travel",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/deobibila/peepaway"
  },
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev": "yarn workspace peepaway-web dev",
    "build": "yarn workspace peepaway-web build",
    "lint": "yarn workspace peepaway-web lint",
    "typecheck": "yarn workspace peepaway-web typecheck",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "9",
    "lint-staged": "^17.6.0"
  },
  "lint-staged": {
    "apps/web/**/*.{js,jsx,ts,tsx}": "eslint --config apps/web/eslint.config.mjs"
  }
}
